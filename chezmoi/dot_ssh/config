Include ~/.orbstack/ssh/config

# Global Defaults
Host *
    UseKeychain yes
    AddKeysToAgent yes
    IdentityFile ~/.ssh/id_ed25519
    SetEnv TERM=xterm-256color # ghostty fix

# --- Homelab Group Settings ---
Host docker-01 docker-02 plex minecraft-server tailscale forgejo coolify-01 nextcloud
    User ubuntu

# --- Host Definitions ---
Host pi-aux
    HostName 192.168.20.18
    User pi

Host docker-01
    HostName 10.255.102.10

Host docker-02
    HostName 10.255.102.11

Host plex
    HostName 10.255.102.21

Host nextcloud
    HostName 10.255.102.22

Host coolify-01
    HostName 10.255.102.12

Host tailscale
    HostName 10.255.102.188

Host ptero.cloud.jckcthbrt.io
    User ubuntu
    Port 2222
    IdentityFile ~/.ssh/homelab_cloud_arm_id_rsa
