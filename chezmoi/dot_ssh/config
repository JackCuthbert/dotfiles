Include ~/.orbstack/ssh/config

# Global Defaults
Host *
    UseKeychain yes
    AddKeysToAgent yes
    IdentityFile ~/.ssh/id_ed25519
    SetEnv TERM=xterm-256color # ghostty fix

# --- Homelab Group Settings ---
Host docker-01 docker-02 plex minecraft-server tailscale forgejo coolify-01
    User ubuntu

# --- Host Definitions ---
Host pi-aux
    HostName 192.168.20.18
    User pi

Host docker-01
    HostName 192.168.20.32

Host docker-02
    HostName 192.168.20.33

Host plex
    HostName 192.168.20.34

Host coolify-01
    HostName 192.168.20.35

Host forgejo
    HostName 192.168.20.36

Host tailscale
    HostName 192.168.20.148 # DHCP

Host minecraft-server
    HostName 192.168.20.40
