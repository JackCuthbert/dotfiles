{{ if eq .chezmoi.os "darwin" }}
Include ~/.orbstack/ssh/config
{{ end }}

# Global Defaults
Host *
    {{ if eq .chezmoi.os "darwin" }}
    UseKeychain yes
    AddKeysToAgent yes
    SetEnv TERM=xterm-256color # ghostty fix
    {{ end }}

    IdentityFile ~/.ssh/id_ed25519

# --- Homelab Group Settings ---
Host docker-01 docker-02 docker-foreign plex tailscale coolify-01 syncthing
    User ubuntu

# --- Host Definitions ---
Host docker-01
    HostName 10.255.102.10

Host docker-02
    HostName 10.255.102.11

Host docker-foreign
    HostName 10.255.103.10

Host plex
    HostName 10.255.102.21

Host nextcloud
    HostName 10.255.102.22

Host coolify-01
    HostName 10.255.102.12

Host syncthing
    HostName 10.255.102.23

Host tailscale
    HostName 10.255.102.188

Host ptero.cloud.jckcthbrt.io
    User ubuntu
    Port 2222
    IdentityFile ~/.ssh/homelab_cloud_arm_id_rsa
